# Ignore specific folders within the project
__pycache__/
bin/
include/
lib/
share/
etc/

# Additionally, ignore all hidden files and directories
# with the exception of .gitignore and the data directory
.*
!.gitignore
!/data/

# Track the Streamlit theme/server config so deployments match local.
# Never track local secrets: this line must stay AFTER the negation above.
!.streamlit/
.streamlit/secrets.toml

# Ignore the trial file
trial.ipynb

# Exported analytics CSVs
analytics/*.csv

# Instructor-only drill inputs: the clean eastville master and the
# dirt-injection script are answer-key material for the session traps and
# must never reach this public repo. Drill JSONs (engineered artifacts with
# their own keys) are formative-only and are committed; these inputs are not.
course_data/drills/masters/
